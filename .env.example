# Local development only.
#
# This key is used by scripts under scripts/ to smoke-test the OpenRouter API.
# It must NEVER be referenced from extension source: WXT inlines env vars at build
# time and a packed .crx can be unpacked by anyone.
#
# End users authenticate through OpenRouter's OAuth PKCE flow instead.
OPENROUTER_API_KEY=sk-or-v1-...

# A provisioning key — the kind that creates other keys, which an ordinary key
# cannot do. Made in OpenRouter's dashboard under Provisioning API Keys.
#
# The deployed Worker gets its own copy through `wrangler secret put`, and
# `worker/.dev.vars` gets one for `wrangler dev`. This line is only so the value
# lives somewhere on disk that is already gitignored.
OPENROUTER_MANAGEMENT_API_KEY=sk-or-v1-...
