---
import { INSTALL_URL, IN_STORE } from '../lib/links';

/**
 * The masthead. Sticky, and transparent until the page moves under it.
 *
 * The line and the blur arrive together on first scroll (`data-stuck`, set by
 * the script at the bottom of `Base.astro`): over the hero there is nothing to
 * separate it from, and a bar with a border sitting on top of a heading reads
 * as a browser chrome nobody asked for.
 *
 * `nav` is hidden below `md`. The links are anchors into a page a phone
 * scrolls through in a few flicks, and a hamburger for four in-page anchors is
 * a menu built for the developer rather than the reader.
 *
 * The mark carries `alt=""`: the name is set in type right beside it, and a
 * screen reader that announces "Reply AI" twice has been made worse, not more
 * accessible. It sits outside the baseline group so that the two words stay on
 * one baseline while the mark centres against the pair.
 */
interface Props {
  /** Anchor links, in order. Absent on the pages that are not the landing. */
  links?: { href: string; label: string }[];
}

const { links = [] } = Astro.props;
---

<header
  id="masthead"
  data-stuck="false"
  class="sticky top-0 z-50 border-b border-transparent transition-colors duration-200 data-[stuck=true]:border-line data-[stuck=true]:bg-bg/80 data-[stuck=true]:backdrop-blur-md"
>
  <div class="mx-auto flex h-16 max-w-6xl items-center gap-6 px-5">
    <a href="/" class="group flex shrink-0 items-center gap-2.5">
      <img
        src="/logo-orange.png"
        alt=""
        width="273"
        height="268"
        class="h-5 w-auto"
        decoding="async"
      />
      <span class="flex items-baseline gap-2">
        <span class="text-[15px] font-semibold tracking-[-0.01em]">Reply AI</span>
        <span class="hidden text-[13px] text-white/45 transition-colors duration-150 group-hover:text-white/70 sm:inline">
          YouTube comment assistant
        </span>
      </span>
    </a>

    {
      links.length > 0 && (
        <nav class="ml-auto hidden items-center gap-6 md:flex">
          {links.map((link) => (
            <a
              href={link.href}
              class="text-[13px] text-white/55 transition-colors duration-150 hover:text-white"
            >
              {link.label}
            </a>
          ))}
        </nav>
      )
    }

    <a
      href={INSTALL_URL}
      rel={IN_STORE ? undefined : 'noreferrer'}
      class={`btn-primary ml-auto shrink-0 px-3 py-1.5 text-[13px] ${links.length > 0 ? 'md:ml-0' : ''}`}
    >
      {IN_STORE ? 'Add to Chrome' : 'Get it on GitHub'}
    </a>
  </div>
</header>
