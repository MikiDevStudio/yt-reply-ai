---
import CoffeeButton from '../components/CoffeeButton.astro';
import Micro from '../components/Micro.astro';
import PopoverMock from '../components/PopoverMock.astro';
import Base from '../layouts/Base.astro';
import { INSTALL_URL, IN_STORE, SOURCE_URL } from '../lib/links';

/**
 * The landing page.
 *
 * Every claim on it is checkable against the source in this repository: the
 * context table is `buildReplyPrompt`, the prices are `MODEL_PRESETS`, the tone
 * list is `STYLES`, the creativity table is `CREATIVITY`, and the privacy
 * section is the policy served two directories over. A landing page that
 * promises something the code does not do is a support ticket with a countdown
 * on it.
 */
const links = [
  { href: '#workflow', label: 'How it works' },
  { href: '#panel', label: 'The panel' },
  { href: '#voice', label: 'Your voice' },
  { href: '#pricing', label: 'Pricing' },
  { href: '#faq', label: 'FAQ' },
];

/** The three steps, in the order someone actually does them. */
const steps = [
  {
    n: '01',
    title: 'Connect',
    detail:
      'One click through OpenRouter’s own sign-in. The key it issues is stored on your machine and read by nothing but the extension’s background worker — it never reaches a web page, YouTube included.',
    foot: 'or paste a key you already have',
  },
  {
    n: '02',
    title: 'Teach it your voice',
    detail:
      'Fill in a soul profile: who you are, how you sound, how long replies should run, what to do with praise, questions, criticism and the people who came to argue. Or paste a page you wrote yourself.',
    foot: 'stored locally, never synced',
  },
  {
    n: '03',
    title: 'Reply',
    detail:
      'An AI reply button appears in every comment’s toolbar. Press it, pick a tone, read what comes back, edit it if you like — then press Insert and YouTube’s own Reply button. Nothing is ever posted for you.',
    foot: 'a human presses send, always',
  },
];

/** What the panel actually contains. Each is a control that ships today. */
const controls = [
  {
    title: 'Five tones, one of them automatic',
    detail:
      'Auto matches the comment you are answering. Friendly, humorous, engaging and brief override it. Changing a chip regenerates on the spot.',
    chips: ['auto', 'friendly', 'humorous', 'engaging', 'brief'],
  },
  {
    title: 'Creativity, as five dots',
    detail:
      'Plain, grounded, natural, inventive, bold — each carries its own instruction and its own temperature, because telling a model to be bolder without raising the temperature changes nothing.',
    dots: 3,
  },
  {
    title: 'Channel or viewer',
    detail:
      'The same voice, two standings. As the channel you answer for the channel; as a viewer you speak only for yourself, and the model is told the difference.',
    segments: ['channel', 'viewer'],
  },
  {
    title: 'Any language, detected or pinned',
    detail:
      'The reply follows the comment’s own language by default. Type a language into the header and it is used until you clear it — useful when your audience writes in three.',
    field: 'English',
  },
  {
    title: 'A note, per reply',
    detail:
      'What you know that the page does not: a fact to include, a link to mention, or a rough draft to be fixed up rather than replaced.',
    field: 'mention the follow-up is filmed already',
  },
  {
    title: 'Retries you can compare',
    detail:
      'Every attempt is kept and paged through with ‹ 2/3 ›. Each retry is given a different angle and a step more room than the last, so the second answer is a different answer — not the same one reworded.',
    pager: true,
  },
];

/** The context tiers, straight out of the prompt builder. */
const context = [
  {
    level: 'L0',
    name: 'The comment',
    sent: 'The comment text and your soul profile.',
    cost: '~300 tokens',
  },
  {
    level: 'L1',
    name: '+ the video',
    sent: 'Video title, channel name, and the comment that opened the thread.',
    cost: '~500 tokens',
  },
  {
    level: 'L2',
    name: '+ the description',
    sent: 'The video description, read once and reused for every comment on it.',
    cost: 'first call only',
  },
];

const faq = [
  {
    q: 'Is there a limit?',
    a: 'No. There was one — 50 replies a day — and it was removed: the only thing it measured was how many people it stopped in the middle of a comment section. What is left is a card at the foot of the reply popover every fiftieth reply, under the answer that just arrived — a sentence and a coffee button. It stands in nothing’s way, it closes with its own X, it reports nothing, and a coffee switches it off for good. That is the whole of what the free version costs.',
  },
  {
    q: 'What does it cost to run?',
    a: 'Whatever the model costs, paid to OpenRouter at cost with no markup from us. Measured on the default model: about $0.002 for a reply, and a little more for a retry, which thinks harder on purpose. There are free models in the picker too — they cost nothing and are capped by OpenRouter at 20 requests a minute.',
  },
  {
    q: 'Do you see my comments?',
    a: 'No, and there is no place for them to arrive: nothing of ours sits in that path. The comment goes from your browser to OpenRouter on your own key, and to whichever model provider you picked. We do have one service — it hands a new install its trial key and turns a supporter code into a licence — and it never sees a comment, a reply or a request to generate one.',
  },
  {
    q: 'Will it post replies automatically?',
    a: 'Never. The generated text is put in YouTube’s reply box and stops there. Pressing Reply is yours — which is both the honest design and the right side of the Web Store’s rules on automated engagement.',
  },
  {
    q: 'Does it work in YouTube Studio?',
    a: 'Yes. The same button appears in Studio’s comment inbox, which is where most channel owners actually answer from.',
  },
  {
    q: 'What if the reply is wrong?',
    a: 'Retry with a different tone, raise the creativity, or write a note telling it what to say. Every attempt is kept, so you can compare them and pick one — or throw all three away and type your own. It is a draft, not a decision.',
  },
];
---

<Base
  title="Reply AI — replies to your YouTube comments, in your own voice"
  description="A Chrome extension that drafts replies to YouTube comments in your voice, on your own OpenRouter key. No account, no daily limit, and nothing of ours in the path of a reply."
  links={links}
>
  <!-- ══ 00 · Hero ══════════════════════════════════════════════════════ -->
  <section class="mx-auto max-w-6xl px-5 pb-20 pt-14 md:pt-20">
    <div class="grid items-center gap-14 lg:grid-cols-[minmax(0,1fr)_minmax(0,auto)]">
      <div class="flex min-w-0 flex-col items-start gap-7">
        <Micro n="00" label="extension overview" />

        <h1 class="text-[44px] font-semibold leading-[1.05] tracking-[-0.03em] sm:text-[56px]">
          AI reply<br />
          <span class="text-white/55">in your own voice.</span>
        </h1>

        <!-- The one paragraph that has to survive being read alone. -->
        <p class="max-w-xl border-l-2 border-accent pl-4 text-[16px] leading-[1.65] text-white/70">
          A Chrome extension that sits in YouTube’s own comment toolbar. Press it on a comment and
          it drafts a reply from a profile you wrote about your channel — then you edit it, or
          throw it away, and press Reply yourself.
        </p>

        <div class="flex flex-wrap items-center gap-3">
          <a href={INSTALL_URL} rel={IN_STORE ? undefined : 'noreferrer'} class="btn-primary">
            {IN_STORE ? 'Add to Chrome' : 'Get it on GitHub'}
          </a>
          <a href="#workflow" class="btn-secondary">See how it works</a>
        </div>

        <p class="flex flex-wrap items-center gap-x-3 gap-y-2">
          <span aria-hidden="true" class="size-1.5 rounded-full bg-accent"></span>
          <span class="micro">powered by openrouter · your own key</span>
        </p>
      </div>

      <!-- The panel itself, tilted a few degrees on wide screens the way a
           product shot is — square-on it reads as a screenshot of a bug
           report. Flat on anything narrow, where it is the only thing on the
           row and a tilt would just cost readability. -->
      <div class="relative mx-auto w-full min-w-0 max-w-[460px] lg:[perspective:1600px]" data-reveal>
        <!-- A glow under the panel, not around it: the card carries the one
             shadow this system allows, and the light behind it is what stops a
             near-black rectangle on a near-black page from disappearing. -->
        <div
          aria-hidden="true"
          class="pointer-events-none absolute -inset-y-16 -inset-x-6 -z-10 opacity-60 blur-[90px]"
          style="background: radial-gradient(ellipse at center, rgb(255 138 61 / 0.16) 0%, rgb(157 155 234 / 0.08) 45%, transparent 72%);"
        >
        </div>
        <div class="lg:[transform:rotateY(-9deg)_rotateX(3deg)]">
          <PopoverMock />
        </div>
      </div>
    </div>
  </section>

  <!-- ══ Numbers ═══════════════════════════════════════════════════════ -->
  <section class="mx-auto max-w-6xl px-5 pb-24" data-reveal>
    <dl class="grid gap-px border border-line bg-line sm:grid-cols-2 lg:grid-cols-4">
      {
        [
          { figure: '0', label: 'servers of ours in the path' },
          { figure: '∞', label: 'replies a day, since the cap went' },
          { figure: '$0.002', label: 'per reply on the default model' },
          { figure: '1', label: 'button, in YouTube’s own toolbar' },
        ].map((stat) => (
          <div class="flex flex-col gap-2 bg-surface p-6">
            <dt class="font-mono text-[28px] leading-none text-white">{stat.figure}</dt>
            <dd class="text-[13px] leading-[1.5] text-white/45">{stat.label}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <!-- ══ 01 · Workflow ═════════════════════════════════════════════════ -->
  <section id="workflow" class="mx-auto max-w-6xl px-5 pb-24 pt-8" data-reveal>
    <Micro n="01" label="workflow" />
    <h2 class="mt-6 max-w-2xl text-[32px] font-semibold leading-[1.15] tracking-[-0.02em] sm:text-[38px]">
      Three steps, <span class="text-white/55">and the last one is the only one you repeat.</span>
    </h2>

    <div class="mt-10 grid gap-px border border-line bg-line md:grid-cols-3">
      {
        steps.map((step, index) => (
          <div class="flex flex-col gap-4 bg-surface p-7 transition-colors duration-150 hover:bg-surface-hi">
            <p class="flex items-center gap-3">
              <span class="micro !text-accent">step // {step.n}</span>
            </p>
            <h3 class="text-[22px] font-semibold leading-[1.2] tracking-[-0.015em]">{step.title}</h3>
            <p class="text-[14px] leading-[1.65] text-white/70">{step.detail}</p>
            <p class="mt-auto border-t border-line-soft pt-4">
              <span class="micro">{step.foot}</span>
            </p>
            <span class="sr-only">Step {index + 1} of 3</span>
          </div>
        ))
      }
    </div>
  </section>

  <!-- ══ 02 · The panel ════════════════════════════════════════════════ -->
  <section id="panel" class="mx-auto max-w-6xl px-5 pb-24 pt-8" data-reveal>
    <Micro n="02" label="the panel" />
    <h2 class="mt-6 max-w-2xl text-[32px] font-semibold leading-[1.15] tracking-[-0.02em] sm:text-[38px]">
      Everything is a control, <span class="text-white/55">not a setting you go and find.</span>
    </h2>
    <p class="mt-5 max-w-2xl text-[15px] leading-[1.7] text-white/70">
      The panel opens over the comment you are answering and every decision is made in it —
      460 pixels wide, no page to navigate to, and nothing that moves under the cursor while a
      reply arrives.
    </p>

    <div class="mt-10 grid gap-px border border-line bg-line md:grid-cols-2 lg:grid-cols-3">
      {
        controls.map((control) => (
          <div class="flex flex-col gap-4 bg-surface p-7 transition-colors duration-150 hover:bg-surface-hi">
            <h3 class="text-[16px] font-medium leading-[1.3]">{control.title}</h3>
            <p class="text-[14px] leading-[1.65] text-white/70">{control.detail}</p>

            <div class="mt-auto pt-2">
              {control.chips && (
                <div class="flex flex-wrap gap-2">
                  {control.chips.map((chip, index) => (
                    <span class={index === 0 ? 'chip-on' : 'chip'}>{chip}</span>
                  ))}
                </div>
              )}

              {control.dots && (
                <div class="flex items-center gap-2">
                  <span class="micro">creativity</span>
                  <span class="flex items-center gap-1.5">
                    {[1, 2, 3, 4, 5].map((level) => (
                      <span
                        class={`size-2.5 rounded-full ${level === control.dots ? 'bg-accent' : 'bg-line-hi'}`}
                      />
                    ))}
                  </span>
                </div>
              )}

              {control.segments && (
                <div class="flex w-fit border border-line">
                  {control.segments.map((segment, index) => (
                    <span
                      class={`px-2.5 py-1 font-mono text-[12px] uppercase tracking-[0.1em] ${
                        index === 0
                          ? 'border-t border-t-accent bg-accent-soft text-accent'
                          : 'border-l border-t border-l-line border-t-transparent text-white/55'
                      }`}
                    >
                      {segment}
                    </span>
                  ))}
                </div>
              )}

              {control.field && (
                <div class="border border-line-input bg-bg px-2.5 py-2 text-[13px] text-white/45">
                  {control.field}
                </div>
              )}

              {control.pager && (
                <div class="flex items-center gap-2 font-mono text-[13px] text-white/55">
                  <span>‹</span>
                  <span>2/3</span>
                  <span>›</span>
                  <span class="micro ml-2">each attempt kept</span>
                </div>
              )}
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- ══ 03 · Your voice ═══════════════════════════════════════════════ -->
  <section id="voice" class="mx-auto max-w-6xl px-5 pb-24 pt-8" data-reveal>
    <Micro n="03" label="soul profile" />
    <h2 class="mt-6 max-w-2xl text-[32px] font-semibold leading-[1.15] tracking-[-0.02em] sm:text-[38px]">
      The difference between a reply <span class="text-white/55">and your reply.</span>
    </h2>

    <div class="mt-10 grid gap-6 lg:grid-cols-[minmax(0,3fr)_minmax(0,2fr)]">
      <div class="card flex flex-col gap-5">
        <span class="micro">built from questions</span>
        <p class="text-[15px] leading-[1.7] text-white/70">
          Answer a handful of them and the profile writes itself: what the channel is, how you
          sound, how long a reply should run, whether emoji are welcome, and the words that sound
          like you rather than like a brand.
        </p>

        <div class="flex flex-wrap gap-2">
          <span class="chip-on">warm</span>
          <span class="chip-on">funny</span>
          <span class="chip">concise</span>
          <span class="chip">enthusiastic</span>
          <span class="chip">expert</span>
          <span class="chip">dry</span>
          <span class="chip">encouraging</span>
          <span class="chip">blunt</span>
        </div>

        <div class="grid gap-px border border-line bg-line sm:grid-cols-2">
          {
            [
              ['praise', 'Thank them without repeating yourself five times a day.'],
              ['a question', 'Answer it, or say honestly that the answer is a whole video.'],
              ['criticism', 'Take the point. Argue only where there is something to argue.'],
              ['an argument', 'One calm line, or nothing at all — your rule, set once.'],
            ].map(([kind, rule]) => (
              <div class="flex flex-col gap-1.5 bg-surface-hi p-4">
                <span class="micro !text-accent">{kind}</span>
                <span class="text-[13px] leading-[1.55] text-white/70">{rule}</span>
              </div>
            ))
          }
        </div>
      </div>

      <div class="flex flex-col gap-6">
        <div class="card flex flex-col gap-3">
          <span class="micro">or write it yourself</span>
          <p class="text-[14px] leading-[1.65] text-white/70">
            Already have a voice document, a style guide, or a prompt you use elsewhere? Paste it.
            The extension can tighten it or reshape one written for another tool, and you can read
            exactly what gets sent before anything is.
          </p>
        </div>

        <div class="card flex flex-col gap-3">
          <span class="micro">it stays here</span>
          <p class="text-[14px] leading-[1.65] text-white/70">
            The profile lives in this browser’s extension storage. It is not synced to a Google
            account, not backed up by us, and not readable by any page — including YouTube.
          </p>
        </div>

        <div class="card flex flex-col gap-3">
          <span class="micro">what actually gets sent</span>
          <p class="text-[14px] leading-[1.65] text-white/70">
            A screen in settings shows the exact prompt for a real comment: profile, tone,
            context, note. No hidden system message, no telemetry rider.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ══ 04 · Context and cost ═════════════════════════════════════════ -->
  <section id="cost" class="mx-auto max-w-6xl px-5 pb-24 pt-8" data-reveal>
    <Micro n="04" label="context & cost" />
    <h2 class="mt-6 max-w-2xl text-[32px] font-semibold leading-[1.15] tracking-[-0.02em] sm:text-[38px]">
      You decide how much it knows, <span class="text-white/55">and pay for exactly that.</span>
    </h2>
    <p class="mt-5 max-w-2xl text-[15px] leading-[1.7] text-white/70">
      Context is tiered, because context is what a reply costs. Most comments need none of it —
      and the tier that does costs a fraction of a cent, once per video rather than once per
      comment.
    </p>

    <div class="mt-10 overflow-x-auto border border-line">
      <table class="w-full min-w-[560px] border-collapse text-left">
        <thead>
          <tr class="border-b border-line bg-surface-hi">
            <th class="micro p-4">level</th>
            <th class="micro p-4">what it adds</th>
            <th class="micro p-4">sent to the model</th>
            <th class="micro p-4">rough size</th>
          </tr>
        </thead>
        <tbody>
          {
            context.map((row) => (
              <tr class="border-b border-line-soft bg-surface last:border-b-0">
                <td class="p-4 font-mono text-[13px] text-accent">{row.level}</td>
                <td class="p-4 text-[14px] font-medium">{row.name}</td>
                <td class="p-4 text-[14px] text-white/70">{row.sent}</td>
                <td class="p-4 font-mono text-[13px] text-white/55">{row.cost}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <div class="mt-6 grid gap-px border border-line bg-line md:grid-cols-3">
      <div class="flex flex-col gap-2 bg-surface p-6">
        <span class="micro">caching</span>
        <p class="text-[14px] leading-[1.6] text-white/70">
          The video’s context is read once and reused for every comment under it, so the shared
          part of the prompt is billed at a fraction on repeat calls.
        </p>
      </div>
      <div class="flex flex-col gap-2 bg-surface p-6">
        <span class="micro">retries think harder</span>
        <p class="text-[14px] leading-[1.6] text-white/70">
          The first attempt is held to minimal reasoning; pressing retry says the obvious answer
          missed, so the next one is allowed to look for a different one — and the token count is
          shown, never hidden.
        </p>
      </div>
      <div class="flex flex-col gap-2 bg-surface p-6">
        <span class="micro">no youtube api</span>
        <p class="text-[14px] leading-[1.6] text-white/70">
          Titles and descriptions are read from the page you already have open. No API key of
          YouTube’s, no quota to run out of, nothing to authorise.
        </p>
      </div>
    </div>
  </section>

  <!-- ══ 05 · Models ═══════════════════════════════════════════════════ -->
  <section id="models" class="mx-auto max-w-6xl px-5 pb-24 pt-8" data-reveal>
    <Micro n="05" label="models" />
    <h2 class="mt-6 max-w-2xl text-[32px] font-semibold leading-[1.15] tracking-[-0.02em] sm:text-[38px]">
      One key, <span class="text-white/55">every model worth having.</span>
    </h2>

    <div class="mt-10 grid gap-px border border-line bg-line md:grid-cols-3">
      {
        [
          {
            tag: 'default',
            id: 'google/gemini-3.6-flash',
            note: 'Thinks before it answers, and it shows in the replies. About $0.002 each.',
          },
          {
            tag: 'cheapest',
            id: 'google/gemini-3.1-flash-lite',
            note: 'No reasoning step, and a twentieth of the price. Fine for straightforward praise.',
          },
          {
            tag: 'free',
            id: 'nvidia/nemotron-3-nano-30b-a3b:free',
            note: 'Costs nothing at all. OpenRouter caps free variants at 20 requests a minute.',
          },
        ].map((model) => (
          <div class="flex flex-col gap-3 bg-surface p-6">
            <span class="micro !text-accent">{model.tag}</span>
            <p class="break-all font-mono text-[13px] text-violet">{model.id}</p>
            <p class="text-[14px] leading-[1.6] text-white/70">{model.note}</p>
          </div>
        ))
      }
    </div>

    <p class="mt-6 max-w-2xl text-[14px] leading-[1.7] text-white/45">
      Or type any model id OpenRouter carries — the picker checks it against the live catalogue
      and tells you what it costs before you switch. A model that is withdrawn later is caught
      when settings next opens, rather than at the moment you needed a reply.
    </p>
  </section>

  <!-- ══ 06 · Privacy ══════════════════════════════════════════════════ -->
  <section id="privacy" class="mx-auto max-w-6xl px-5 pb-24 pt-8" data-reveal>
    <Micro n="06" label="privacy" />
    <h2 class="mt-6 max-w-2xl text-[32px] font-semibold leading-[1.15] tracking-[-0.02em] sm:text-[38px]">
      No server <span class="text-white/55">is ever in the path of a reply.</span>
    </h2>

    <div class="mt-10 grid gap-6 md:grid-cols-3">
      <div class="card flex flex-col gap-3">
        <span class="micro">no account</span>
        <p class="text-[14px] leading-[1.65] text-white/70">
          Nothing to sign up for, nothing to log into, no identifier of any kind. The extension has
          no way to know that you exist.
        </p>
      </div>
      <div class="card flex flex-col gap-3">
        <span class="micro">no telemetry</span>
        <p class="text-[14px] leading-[1.65] text-white/70">
          No usage pings, no error reports, no install beacon. Two hosts are reachable at all and
          the manifest is scoped so no third can be: openrouter.ai, where the replies are written,
          and one of ours — touched at most twice in the life of an install, and only when you
          press something.
        </p>
      </div>
      <div class="card flex flex-col gap-3">
        <span class="micro">your key, your terms</span>
        <p class="text-[14px] leading-[1.65] text-white/70">
          The key is stored on your device, spends only what you cap it at, and can be revoked at
          OpenRouter in one click.
        </p>
      </div>
    </div>

    <p class="mt-6 max-w-2xl text-[14px] leading-[1.7] text-white/45">
      Ours is contacted twice at most: once for the free trial key, once to turn a supporter code
      into a licence. Neither carries a word of anybody's comment, neither happens unless you press
      something, and after them the extension never speaks to us again — a licence is checked
      against a key that ships inside the extension, so it keeps working whatever happens to us.
    </p>

    <p class="mt-6 text-[14px] text-white/45">
      The full policy — every stored item, every field of every request — is on the
      {' '}
      <a class="text-white/70 underline decoration-line-hi underline-offset-4 transition-colors hover:text-white" href="/privacy">privacy page</a>,
      and the code that implements it is
      {' '}
      <a class="text-white/70 underline decoration-line-hi underline-offset-4 transition-colors hover:text-white" href={SOURCE_URL} rel="noreferrer">public</a>.
    </p>
  </section>

  <!-- ══ 07 · Pricing ══════════════════════════════════════════════════ -->
  <section id="pricing" class="mx-auto max-w-6xl px-5 pb-24 pt-8" data-reveal>
    <Micro n="07" label="pricing" center />
    <h2 class="mx-auto mt-6 max-w-2xl text-center text-[32px] font-semibold leading-[1.15] tracking-[-0.02em] sm:text-[38px]">
      Free, and <span class="text-white/55">not the kind that runs out.</span>
    </h2>

    <div class="mx-auto mt-10 grid max-w-6xl gap-6 md:grid-cols-3">
      <!-- The real product. It gets the solid button, because it is the one
           thing on this page anybody can have without paying. -->
      <div class="flex flex-col gap-5 border border-line-hi bg-surface p-7">
        <div class="flex flex-col gap-1">
          <h3 class="text-[24px] font-semibold tracking-[-0.02em]">Free</h3>
          <span class="micro">everything, on your own key</span>
        </div>
        <p class="font-mono text-[28px] leading-none">
          $0<span class="text-[15px] text-white/45"> / forever</span>
        </p>
        <ul class="flex flex-col gap-3 text-[14px] text-white/70">
          {
            [
              'Unlimited replies — no daily cap, no counter to watch',
              'Every tone, every model, every control in the panel',
              'Soul profile, retries, languages, YouTube Studio',
              'About twenty replies to start with, on our key, before any account exists',
              'After that, models billed by OpenRouter at cost — or free variants for nothing',
            ].map((line) => (
              <li class="flex gap-3">
                <span aria-hidden="true" class="mt-2 size-1.5 shrink-0 rounded-full bg-accent" />
                {line}
              </li>
            ))
          }
        </ul>
        <a
          href={INSTALL_URL}
          rel={IN_STORE ? undefined : 'noreferrer'}
          class="btn-primary mt-auto w-full"
        >
          {IN_STORE ? 'Add to Chrome' : 'Get it on GitHub'}
        </a>
      </div>

      <!-- Support. A donation card, and the hardest one on the page to write:
           it has to be worth pressing while promising nothing at all. The
           moment it promises something, a coffee stops being a donation and
           becomes a sale — with VAT, Trader status and a right of withdrawal
           behind it. So the bullets say what the money pays for, never what the
           payer receives. Its button is Buy Me a Coffee's own mark rather than a
           second solid button of ours (brand.md §1). -->
      <div class="flex flex-col gap-5 border border-line bg-surface p-7">
        <div class="flex flex-col gap-1">
          <h3 class="text-[24px] font-semibold tracking-[-0.02em]">Support</h3>
          <span class="micro">a coffee, buying nothing</span>
        </div>
        <p class="font-mono text-[28px] leading-none">
          a coffee<span class="text-[15px] text-white/45"> / if you feel like it</span>
        </p>
        <ul class="flex flex-col gap-3 text-[14px] text-white/70">
          {
            [
              'Nothing changes in the extension. There is no tier here to unlock',
              'It pays for the trial keys new installs run on — those are real cents, spent by us',
              'And for the domain, the mail and the small service behind them',
              'Once, never, or whenever. The product is the same either way',
            ].map((line) => (
              <li class="flex gap-3">
                <span aria-hidden="true" class="mt-2 size-1.5 shrink-0 rounded-full bg-line-hi" />
                {line}
              </li>
            ))
          }
        </ul>
        <p class="text-[13px] leading-[1.6] text-white/45">
          This is a thank-you, not a purchase — there is nothing here to buy, and pressing it buys
          nothing. The free column above is the whole product.
        </p>
        <CoffeeButton class="mt-auto w-full justify-center" />
      </div>

      <!-- Pro. Outlined, never filled: nothing here is for sale and the card
           must not read as a checkout. -->
      <div class="flex flex-col gap-5 border border-line bg-surface/60 p-7">
        <div class="flex flex-col gap-1">
          <h3 class="text-[24px] font-semibold tracking-[-0.02em]">Pro</h3>
          <span class="micro">unbuilt</span>
        </div>
        <p class="font-mono text-[28px] leading-none text-white/45">
          —<span class="text-[15px]"> / undecided</span>
        </p>
        <ul class="flex flex-col gap-3 text-[14px] text-white/70">
          {
            [
              'A scanner that points at the comments worth answering',
              'Bulk drafting for a whole page of comments',
              'A key we provision, so there is no OpenRouter account to set up',
              'Saved voices — a channel, a client, a second language',
            ].map((line) => (
              <li class="flex gap-3">
                <span aria-hidden="true" class="mt-2 size-1.5 shrink-0 rounded-full bg-line-hi" />
                {line}
              </li>
            ))
          }
        </ul>
        <p class="text-[13px] leading-[1.6] text-white/45">
          None of it exists. The waitlist is a ballot: tick what you would pay for, and that is the
          order it gets built in — or it does not get built at all.
        </p>
        <a href="/pro" class="btn-secondary mt-auto w-full">Vote on the waitlist</a>
      </div>
    </div>

    <!-- The argument the columns cannot make on their own. Two sentences, and
         the number in the first is the one measured in the extension's own
         repository — see `npm run measure`. -->
    <div class="mx-auto mt-10 grid max-w-6xl gap-6 md:grid-cols-2">
      <div class="flex flex-col gap-3 border border-line bg-surface p-7">
        <span class="micro">why free has no cap</span>
        <p class="text-[15px] leading-[1.7] text-white/70">
          Because the replies run on your own OpenRouter key. Metering them would be metering
          something you already pay for, so there is no cap to lift and no number that could ever be
          worth selling you. One did ship, at fifty replies a day, and the only thing it measured
          was how many people it stopped in the middle of a comment section.
        </p>
      </div>
      <div class="flex flex-col gap-3 border border-line bg-surface p-7">
        <span class="micro">what a reply actually costs</span>
        <p class="text-[15px] leading-[1.7] text-white/70">
          About <span class="font-mono text-white">$0.002</span> on the default model — measured,
          not estimated — paid to OpenRouter at cost with nothing added by us. The first thirty or
          so are on our key and need no account at all, which makes the price of finding out
          exactly nothing. Those thirty are what a coffee pays for, for somebody else.
        </p>
      </div>
    </div>
  </section>

  <!-- ══ 08 · FAQ ══════════════════════════════════════════════════════ -->
  <section id="faq" class="mx-auto max-w-3xl px-5 pb-24 pt-8" data-reveal>
    <Micro n="08" label="questions" />
    <h2 class="mt-6 text-[32px] font-semibold leading-[1.15] tracking-[-0.02em] sm:text-[38px]">
      The awkward ones, <span class="text-white/55">answered first.</span>
    </h2>

    <div class="mt-10 border border-line">
      {
        faq.map((item) => (
          <details class="group border-b border-line-soft last:border-b-0 open:bg-surface">
            <summary class="flex cursor-pointer list-none items-center gap-4 p-5 text-[15px] font-medium transition-colors duration-150 hover:bg-surface-hi">
              {item.q}
              <span
                aria-hidden="true"
                class="ml-auto font-mono text-[18px] leading-none text-accent transition-transform duration-150 group-open:rotate-45"
              >
                +
              </span>
            </summary>
            <p class="px-5 pb-5 text-[14px] leading-[1.7] text-white/70">{item.a}</p>
          </details>
        ))
      }
    </div>
  </section>

  <!-- ══ Closing ═══════════════════════════════════════════════════════ -->
  <section class="mx-auto max-w-6xl px-5 pb-8 pt-8" data-reveal>
    <div class="flex flex-col items-center gap-7 border border-line bg-surface px-6 py-16 text-center">
      <Micro label="one button, in a toolbar you already use" center />
      <h2 class="max-w-2xl text-[34px] font-semibold leading-[1.15] tracking-[-0.02em] sm:text-[42px]">
        Your comment section, <span class="text-white/55">answered by you.</span>
      </h2>
      <div class="flex flex-wrap items-center justify-center gap-3">
        <a href={INSTALL_URL} rel={IN_STORE ? undefined : 'noreferrer'} class="btn-primary">
          {IN_STORE ? 'Add to Chrome' : 'Get it on GitHub'}
        </a>
        <a href="/pro" class="btn-secondary">What Pro would add</a>
      </div>
      {
        !IN_STORE && (
          <p class="micro max-w-md">
            the chrome web store listing is in preparation · until then it loads unpacked from the
            repository
          </p>
        )
      }
    </div>
  </section>
</Base>
