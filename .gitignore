# Secrets
.env
.env.*
!.env.example

# The Worker's local secrets. `wrangler dev` reads this file the way the
# deployed Worker reads `wrangler secret put` — same value, no repository.
.dev.vars
.dev.vars.*

# MCP server config: it carries the n8n API key inline, in plain text
.mcp.json

# Decision log. Kept on disk, deliberately out of a public repository: it holds
# revenue expectations, the pricing options still under discussion, and the
# reasoning about what a shipped client cannot protect. Removed from the history
# as well, so publishing the repo does not publish it retroactively.
docs/plans/
docs/stitch_smart_youtube_ai_replies/

# Extension signing key — losing it is survivable, leaking it is not
.keys/

# Infrastructure notes: workflow definitions, host names, resource ids. No
# secrets in them, but the repository is public and none of it is anyone else's
# business. Kept on disk, and stripped from the history for the same reason as
# the decision log.
ops/

# Legacy projects (reference only, not part of this repo)
Reply-AI-YT/
yt-reply-extension/

# Agent skills: real files live in .agents/skills, .claude/skills are junctions to them
.claude/skills/

# Dependencies
node_modules/

# Build output. `site/` is the exception and is committed on purpose: it is the
# website, built from `landing/`, and the host deploys it by pulling.
.output/
.wxt/
.astro/
.wrangler/
dist/
*.zip

# Playwright MCP's scratch output, written wherever it happens to be invoked
.playwright-mcp/

# Editor / OS
.DS_Store
Thumbs.db
*.log

# Screenshots, mockups and stray images. Anything that ships is exempt — the
# extension's icons, the marks bundled into its UI, and the landing page's own
# assets. Without the exceptions a new icon size or a new site image would be
# skipped by `git add` in silence.
*.png
*.jpeg
*.jpg
!extension/public/icon/*.png
!extension/assets/*.png
!landing/public/**/*.png
!landing/public/**/*.jpg
!site/**/*.png
!site/**/*.jpg

# Reference comments pulled from YouTube to tune the reply prompt against. Real
# people's writing, under their own display names, on a public repository: kept
# on disk and not published, the same as the notes above.
research/
