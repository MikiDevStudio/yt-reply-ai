# Secrets
.env
.env.*
!.env.example

# MCP server config: it carries the n8n API key inline, in plain text
.mcp.json

# Decision log. Kept on disk, deliberately out of a public repository: it holds
# revenue expectations, the pricing options still under discussion, and the
# reasoning about what a shipped client cannot protect. Removed from the history
# as well, so publishing the repo does not publish it retroactively.
docs/plans/

# Extension signing key — losing it is survivable, leaking it is not
.keys/

# Infrastructure notes: workflow definitions, host names, resource ids. No
# secrets in them, but the repository is public and none of it is anyone else's
# business. Kept on disk, and stripped from the history for the same reason as
# the decision log.
ops/

# Legacy projects (reference only, not part of this repo)
Reply-AI-YT/
yt-reply-extension/

# Agent skills: real files live in .agents/skills, .claude/skills are junctions to them
.claude/skills/

# Dependencies
node_modules/

# Build output
.output/
.wxt/
dist/
*.zip

# Editor / OS
.DS_Store
Thumbs.db
*.log

# Screenshots, mockups and stray images. The extension's own icons are shipped
# code, so they are exempt — without the exception a new icon size would be
# skipped by `git add` in silence.
*.png
*.jpeg
*.jpg
!extension/public/icon/*.png

