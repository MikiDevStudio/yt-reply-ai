{
  "name": "yt-reply-ai",
  "description": "AI reply assistant for YouTube comments",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "smoke": "tsx scripts/smoke-openrouter.ts",
    "measure": "tsx scripts/measure-reply-cost.ts",
    "comments": "tsx scripts/fetch-comments.ts",
    "eval:set": "tsx scripts/build-eval-set.ts",
    "eval": "tsx scripts/run-prompt-eval.ts",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "lucide-react": "^1.31.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router": "^8.3.0"
  },
  "devDependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/roboto": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/module-react": "^1.1.5",
    "daisyui": "^5.7.15",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.5",
    "typescript": "^5.9.3",
    "wxt": "^0.21.3"
  }
}
